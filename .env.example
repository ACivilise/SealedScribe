# Environment Template

# Connexion Microsoft (Entra ID) : optionnelle, se configure dans Paramètres > Général
# (ID d'application et ID de l'annuaire). Aucune variable d'environnement n'est lue pour elle.

# Secrets Azure et Mistral : lus par le backend Rust en développement uniquement (sans préfixe
# VITE_, jamais compilés dans le front). En usage normal, saisir les clés dans Paramètres
# (Transcription, Résumé IA) : elles sont stockées dans le Gestionnaire d'identifiants Windows.
AZURE_SPEECH_KEY=your_speech_service_key
AZURE_SPEECH_REGION=francecentral
AZURE_AI_INFERENCE_ENDPOINT=your_ai_inference_endpoint
AZURE_AI_INFERENCE_KEY=your_ai_inference_key
MISTRAL_API_KEY=your_mistral_api_key

# Development
NODE_ENV=development
